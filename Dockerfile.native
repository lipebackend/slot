# syntax=docker/dockerfile:1

FROM node:22-alpine AS frontend-build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM ghcr.io/graalvm/native-image-community:21 AS native-build
WORKDIR /src
COPY backend/.mvn .mvn
COPY backend/mvnw backend/pom.xml ./
COPY backend/src src
RUN rm -rf src/main/resources/static/*
COPY --from=frontend-build /app/dist/slot-frontend/browser/ src/main/resources/static/
RUN chmod +x mvnw && ./mvnw -B -Pnative native:compile -DskipTests
RUN strip /src/target/slot || true

FROM alpine:3.20 AS upx-pack
RUN apk add --no-cache upx
COPY --from=native-build /src/target/slot /tmp/slot
RUN upx --best --lzma /tmp/slot || true

FROM gcr.io/distroless/base-debian12:nonroot
WORKDIR /app
COPY --from=upx-pack /tmp/slot /app/slot
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/slot"]
